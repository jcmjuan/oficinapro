        int responsavel_id FK
        string status
        float desconto
        datetime data_abertura
        datetime data_finalizacao
        string observacoes
    }

    ITEM_OS {
        int id PK
        int ordem_id FK
        string tipo
        string descricao
        float quantidade
        float valor_unitario
        float horas
