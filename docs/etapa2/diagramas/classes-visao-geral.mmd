classDiagram
    direction TB

    class Pessoa {
        <<abstract>>
        -nome : str
        -telefone : str
        -email : str
        +resumo()* str
    }

    class Cliente {
        -cpfCnpj : str
        -endereco : str
        +adicionarVeiculo(v : Veiculo) void
    }

    class Mecanico {
        -registro : str
        -especialidade : str
        -taxaComissao : float
        +calcularComissao(valor : float) float
    }

    class Veiculo {
        -placa : str
        -marca : str
        -modelo : str
        -ano : int
        -km : int
        +historico() list
    }

    class ItemOS {
        <<abstract>>
        -descricao : str
        -quantidade : float
        -valorUnitario : float
        +calcularSubtotal()* float
        +descrever()* str
    }

    class Peca {
        -codigo : str
        -fornecedor : str
        +calcularSubtotal() float
    }

    class MaoDeObra {
        -horas : float
        -taxaHoraria : float
        +calcularSubtotal() float
    }

    class OrdemServico {
        -numero : str
        -status : StatusOS
        -desconto : float
        +adicionarItem(item : ItemOS) void
        +calcularTotal() float
        +aprovar() void
        +finalizar() void
        -__recalcularTotal() void
    }

    class Oficina {
        -nome : str
        -taxaHorariaPadrao : float
        +emitirOrdemServico() OrdemServico
        +relatorioComissoes() list
    }

    class StatusOS {
        <<enumeration>>
        ORCAMENTO
        APROVADA
        EM_EXECUCAO
        FINALIZADA
        CANCELADA
    }

    Pessoa <|-- Cliente
    Pessoa <|-- Mecanico
    ItemOS <|-- Peca
    ItemOS <|-- MaoDeObra

    Cliente "1" --> "0..*" Veiculo : possui
    Cliente "1" --> "0..*" OrdemServico : solicita
    Veiculo "1" --> "0..*" OrdemServico : recebe
    Mecanico "1" --> "0..*" OrdemServico : responsável
    OrdemServico "1" *-- "1..*" ItemOS : contém
    Mecanico "1" --> "0..*" MaoDeObra : executa
    Oficina "1" --> "0..*" Cliente : atende
    Oficina "1" --> "0..*" Mecanico : emprega
    Oficina "1" --> "0..*" OrdemServico : gerencia
    OrdemServico --> StatusOS : usa
