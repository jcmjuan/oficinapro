classDiagram
    direction LR

    class Pessoa {
        <<abstract>>
        +resumo()* str
    }
    class Cliente {
        +adicionarVeiculo() void
    }
    class Mecanico {
        +calcularComissao() float
    }
    class Veiculo {
        +historico() list
    }
    class ItemOS {
        <<abstract>>
        +calcularSubtotal()* float
    }
    class Peca {
        +calcularSubtotal() float
    }
    class MaoDeObra {
        +calcularSubtotal() float
    }
    class OrdemServico {
        +calcularTotal() float
        +aprovar() void
    }
    class Oficina {
        +emitirOrdemServico() OrdemServico
    }
    class StatusOS {
        <<enumeration>>
        ORCAMENTO
        APROVADA
        EM_EXECUCAO
        FINALIZADA
        CANCELADA
    }

    Pessoa <|-- Cliente
    Pessoa <|-- Mecanico
    ItemOS <|-- Peca
    ItemOS <|-- MaoDeObra

    Cliente "1" --> "0..*" Veiculo : possui
    Cliente "1" --> "0..*" OrdemServico : solicita
    Veiculo "1" --> "0..*" OrdemServico : recebe
    Mecanico "1" --> "0..*" OrdemServico : responsável
    OrdemServico "1" *-- "1..*" ItemOS : contém
    Mecanico "1" --> "0..*" MaoDeObra : executa
    Oficina "1" --> "0..*" Cliente : atende
    Oficina "1" --> "0..*" Mecanico : emprega
    Oficina "1" --> "0..*" OrdemServico : gerencia
    OrdemServico --> StatusOS : usa
